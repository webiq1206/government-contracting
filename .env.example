# ============================================================================
# BROSTCO — Autonomous Procurement Execution Platform
#
# Copy this file to `.env` and replace the placeholders with your real values:
#     cp .env.example .env
#
# Every secret below is shown as a <angle-bracket placeholder> whose text hints
# at the expected format. Replace the WHOLE token, angle brackets included, e.g.
#     SAM_API_KEY=<your-sam-gov-api-key>   ->   SAM_API_KEY=a1b2c3d4e5f6...
#
# Anything you leave as a <...> placeholder is treated as unset: the platform
# runs with graceful degradation, so that integration is simply disabled (and
# clearly logged) rather than crashing or firing a bad credential. Fill keys in
# as you get them and features light up automatically. Only the fields marked
# REQUIRED are needed to boot.
# ============================================================================

# ---- Core (REQUIRED) -------------------------------------------------------
# Postgres connection string. On Supabase: Project Settings -> Database ->
# Connection string (use the "Session" pooler URI for the app, port 5432/6543).
# The value below works for a local Postgres named "brostco".
DATABASE_URL=postgresql://postgres:password@localhost:5432/brostco

# Public app URL (used for OAuth callbacks, email links, tracking pixels).
# Local dev: http://localhost:3000. On Replit: your https://*.replit.app URL.
APP_URL=http://localhost:3000

# A long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=<paste-a-64+-char-random-hex-string>

# ---- SaaS billing (Stripe) -------------------------------------------------
# Required for public paid signup. Without these keys, signup can still create
# an account in development and activate a local subscription for testing.
STRIPE_SECRET_KEY=<sk_live_or_sk_test>
STRIPE_WEBHOOK_SECRET=<whsec_...>
# Recurring monthly Price IDs created in the Stripe Dashboard.
STRIPE_PRICE_STANDARD=<price_..._2997>
STRIPE_PRICE_FOUNDING=<price_..._497>
# Optional hard end for founding promo (ISO timestamp). If unset, the app
# starts a 5-day window on first landing-page load and stores it in app_settings.
# FOUNDING_PROMO_ENDS_AT=2026-08-16T00:00:00.000Z

# Single-operator login. EASIEST: set OPERATOR_EMAIL + OPERATOR_PASSWORD and
# the worker creates (or updates) that operator account automatically at boot.
# Only the scrypt hash is stored; the password never leaves the environment.
OPERATOR_EMAIL=you@yourcompany.com
OPERATOR_PASSWORD=<your-login-password>

# Alternative (advanced): pre-hashed login fallback used only when the users
# table has no matching row. Generate with:
#   npm run agent -- hash-password 'yourpassword'
# OPERATOR_PASSWORD_HASH=<scrypt$...   paste-output-of-hash-password>

# ---- Supabase (storage; optional but recommended) --------------------------
# If set, document files (solicitations, generated bids, capability statements)
# are stored in Supabase Storage. If unset, files are stored on local disk under
# ./.data/storage (fine for dev; not durable on Replit).
# Get these at: Supabase -> Project Settings -> API.
SUPABASE_URL=<https://your-project-ref.supabase.co>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key-starts-with-eyJ>
SUPABASE_STORAGE_BUCKET=brostco-documents

# ---- Anthropic Claude API (REQUIRED for AI agents) -------------------------
# Get a key at https://console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=<sk-ant-api03-...>
# Tiered models. CLAUDE_MODEL is the default for high-volume, lower-stakes
# agents (scoring, outreach, call prep, sub-verify, digests) — fast and cheap.
# CLAUDE_MODEL_SMART is used only on the bid-critical path (Solicitation Analyst
# bid brief + Learning Loop weight analysis), where a missed requirement or a
# fabricated fact costs a bid. The defaults below are recommended — leave as-is.
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_MODEL_SMART=claude-sonnet-5

# ---- SAM.gov (opportunity ingestion, award/exclusion monitoring) -----------
# Free key: sign in at https://sam.gov -> Account Details -> Request API Key.
SAM_API_KEY=<your-sam-gov-api-key>

# ---- USASpending.gov (historical pricing comps) ----------------------------
# No key required — public API. Base URL only (rarely changed).
USASPENDING_BASE_URL=https://api.usaspending.gov

# ---- BLS (CPI inflation adjustment) ----------------------------------------
# Optional. A free registration key raises rate limits; works unauthenticated at
# low volume. Register at https://data.bls.gov/registrationEngine/.
BLS_API_KEY=<optional-bls-registration-key>

# ---- Google Maps / Places (subcontractor discovery) ------------------------
# Google Cloud Console -> APIs & Services -> Credentials (enable Places API).
GOOGLE_MAPS_API_KEY=<AIzaSy...>

# ---- Hunter.io (subcontractor email discovery + verification) --------------
# Get a key at https://hunter.io -> API.
HUNTER_API_KEY=<your-hunter-io-api-key>

# ---- Ahrefs (Site Authority / backlink module) -----------------------------
# PAID, requires an Ahrefs plan with API access and is billed per row of data
# pulled. Powers Domain Rating tracking, competitor referring-domain mining and
# broken-link prospecting. Left unset, the Site Authority scan logs a skip and
# its dashboard stays empty; nothing else is affected.
# Key: https://app.ahrefs.com/api/profile (Account -> API keys).
# Both fields can also be set from the UI at /settings/integrations, which has
# a Test connection button and takes precedence over the values here.
AHREFS_API_KEY=<your-ahrefs-api-key>
# The domain you are building authority for.
AHREFS_TARGET=brostco.com

# ---- Gmail API (outreach send + reply/open/click tracking) -----------------
# OAuth 2.0 client from Google Cloud Console (Gmail API enabled).
# Authorized redirect URI must be: {APP_URL}/api/integrations/gmail/callback
GMAIL_CLIENT_ID=<xxxxxxxx.apps.googleusercontent.com>
GMAIL_CLIENT_SECRET=<GOCSPX-...>
# Leave blank — populated automatically after you complete OAuth at
# /settings/integrations.
GMAIL_REFRESH_TOKEN=
# The Gmail address outreach is sent from.
GMAIL_SENDER=<outreach@yourdomain.com>

# ---- Twilio (urgent SMS alerts) --------------------------------------------
# From the Twilio Console dashboard (Account SID + Auth Token + a From number).
TWILIO_ACCOUNT_SID=<ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
TWILIO_FROM_NUMBER=<+12085551234>
# Where urgent alerts are sent (the operator's mobile, E.164 format).
ALERT_SMS_TO=<+12085557890>

# ---- Platform system email (digests, alerts, password resets) --------------
# Delivered through the platform's own connected Google inbox. Optional From
# override; defaults to the connected address.
SYSTEM_MAIL_FROM=
DIGEST_EMAIL_TO=operator@brostco.com

# ---- Queue (optional Redis / BullMQ upgrade) -------------------------------
# Leave as the placeholder (or blank) to use the Postgres-backed queue (pg-boss)
# — runs on Replit with no extra infra. Set a real Redis URL (e.g. an Upstash
# rediss:// URL) to switch the queue backend to BullMQ.
REDIS_URL=<rediss://default:password@your-host:6379>

# ---- Runtime toggles -------------------------------------------------------
# Set to "false" on the web-only service if you run web and worker separately.
RUN_WORKER=true
# Comma-separated cron agent names to DISABLE (e.g. opportunity-monitor).
DISABLED_AGENTS=
# Playwright scrapers off by default (need browser deps). Turn on when ready.
ENABLE_SCRAPERS=false
NODE_ENV=development

# ---- Platform administration ----------------------------------------------
# Comma-separated emails allowed to see billing across every customer account.
# Deliberately an env var, not a database role: cross-tenant visibility must
# not be grantable by anything that happens inside the product.
PLATFORM_ADMIN_EMAILS=

# ---- Stripe prices ---------------------------------------------------------
# Produced by `npm run stripe:setup`. These are identifiers, not secrets.
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_ANNUAL=
STRIPE_PRICE_FOUNDING_MONTHLY=
STRIPE_PRICE_FOUNDING_ANNUAL=
