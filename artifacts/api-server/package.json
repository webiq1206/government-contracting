{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "migrate": "tsx src/lib/migrate.ts",
    "seed": "tsx src/engine/seed.ts",
    "worker": "tsx src/engine/worker.ts",
    "agent": "tsx src/engine/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docx": "^9.0.2",
    "dotenv": "^16.4.5",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "googleapis": "^144.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "pg-boss": "^10.1.5",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "resend": "^4.0.1",
    "twilio": "^5.3.5",
    "unpdf": "^0.12.2",
    "zod": "catalog:"
  },
  "optionalDependencies": {
    "bullmq": "^5.28.1",
    "ioredis": "^5.4.1",
    "playwright": "^1.48.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:",
    "vitest": "^4.1.9"
  }
}
