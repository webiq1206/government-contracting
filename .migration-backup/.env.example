# ============================================================================
# BROSTCO — Autonomous Procurement Execution Platform
# Copy this file to `.env` and fill in the values you have. The platform runs
# with graceful degradation: any integration whose key is missing is disabled
# (and clearly logged) rather than crashing the app. Fill keys in as you get
# them and features light up automatically.
# ============================================================================

# ---- Core (REQUIRED) -------------------------------------------------------
# Postgres connection string. On Supabase: Project Settings -> Database ->
# Connection string (use the "Session" pooler URI for the app, port 5432/6543).
DATABASE_URL=postgresql://postgres:password@localhost:5432/brostco

# Public app URL (used for OAuth callbacks, email links, tracking pixels).
APP_URL=http://localhost:3000

# A long random string. Used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string

# Single-operator login (Phase 1). Set the operator email + password hash.
# Generate a hash with:  npm run agent -- hash-password 'yourpassword'
OPERATOR_EMAIL=operator@brostco.com
OPERATOR_PASSWORD_HASH=

# ---- Supabase (storage; optional but recommended) --------------------------
# If set, document files (solicitations, generated bids, capability statements)
# are stored in Supabase Storage. If unset, files are stored on local disk under
# ./.data/storage (fine for dev; not durable on Replit).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=brostco-documents

# ---- Anthropic Claude API (REQUIRED for AI agents) -------------------------
ANTHROPIC_API_KEY=
# Model used for all agent reasoning. Spec calls for claude-sonnet-4-6.
CLAUDE_MODEL=claude-sonnet-4-6

# ---- SAM.gov (opportunity ingestion, award/exclusion monitoring) -----------
# Get a key at https://sam.gov (Account Details -> API Key). Free.
SAM_API_KEY=

# ---- USASpending.gov (historical pricing comps) ----------------------------
# No key required — public API. Base URL only (rarely changed).
USASPENDING_BASE_URL=https://api.usaspending.gov

# ---- BLS (CPI inflation adjustment) ----------------------------------------
# Optional registration key raises rate limits. Works unauthenticated at low volume.
BLS_API_KEY=

# ---- Google Maps / Places (subcontractor discovery) ------------------------
GOOGLE_MAPS_API_KEY=

# ---- Hunter.io (subcontractor email discovery + verification) --------------
HUNTER_API_KEY=

# ---- Gmail API (outreach send + reply/open/click tracking) -----------------
# OAuth 2.0 client from Google Cloud Console (Gmail API enabled).
# Redirect URI must be: {APP_URL}/api/integrations/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Populated automatically after you complete OAuth at /settings/integrations.
GMAIL_REFRESH_TOKEN=
# The Gmail address outreach is sent from.
GMAIL_SENDER=

# ---- Twilio (urgent SMS alerts) --------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Where urgent alerts are sent (the operator's mobile).
ALERT_SMS_TO=

# ---- Resend (daily/weekly email digests) -----------------------------------
RESEND_API_KEY=
RESEND_FROM=BROSTCO <alerts@brostco.com>
DIGEST_EMAIL_TO=operator@brostco.com

# ---- Queue (optional Redis / BullMQ upgrade) -------------------------------
# Leave unset to use the Postgres-backed queue (pg-boss) — runs on Replit with
# no extra infra. Set REDIS_URL (e.g. an Upstash rediss:// URL) to switch the
# queue backend to BullMQ.
REDIS_URL=

# ---- Runtime toggles -------------------------------------------------------
# Set to "false" on the web-only service if you run web and worker separately.
RUN_WORKER=true
# Comma-separated cron agent names to DISABLE (e.g. opportunity-monitor).
DISABLED_AGENTS=
# Playwright scrapers off by default (need browser deps). Turn on when ready.
ENABLE_SCRAPERS=false
NODE_ENV=development
