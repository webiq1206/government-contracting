{
  "name": "brostco",
  "version": "1.0.0",
  "private": true,
  "description": "BROSTCO, Autonomous Procurement Execution Platform",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n web,worker -c cyan,magenta \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:web": "NODE_ENV=development next dev",
    "dev:worker": "tsx watch worker/index.ts",
    "build": "next build",
    "start": "concurrently -n web,worker -c cyan,magenta --kill-others-on-fail=false --restart-tries -1 --restart-after 5000 \"npm:start:web\" \"npm:start:worker\"",
    "start:web": "next start -p ${PORT:-3000}",
    "start:worker": "tsx worker/index.ts",
    "worker": "tsx worker/index.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "agent": "tsx scripts/run-agent.ts",
    "purge-test-data": "tsx scripts/purge-test-data.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/postinstall.mjs",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "stripe:verify": "tsx scripts/stripe-setup.ts --verify",
    "backfill:doc-names": "tsx scripts/backfill-doc-names.ts",
    "repair:sub-locations": "tsx scripts/repair-sub-locations.ts",
    "queue:retire-dead-jobs": "tsx scripts/retire-dead-jobs.ts",
    "doctor": "tsx scripts/doctor.ts",
    "inventory": "tsx scripts/interface-inventory.ts",
    "repair:email-history": "tsx scripts/repair-email-history.ts",
    "purge-test-orgs": "tsx scripts/purge-test-orgs.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@supabase/supabase-js": "2.109.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.5.2",
    "concurrently": "^9.2.3",
    "date-fns": "^4.1.0",
    "docx": "^9.0.2",
    "dotenv": "^16.6.1",
    "googleapis": "^144.0.0",
    "next": "^14.2.35",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.5",
    "postcss": "^8.5.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^22.5.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.0",
    "twilio": "^5.3.5",
    "typescript": "^5.9.3",
    "unpdf": "^1.8.0",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "bullmq": "^5.28.1",
    "ioredis": "^5.4.1",
    "playwright": "^1.48.2"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "tar": "^7.5.22"
  }
}
