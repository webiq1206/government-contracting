{
  "name": "brostco",
  "version": "1.0.0",
  "private": true,
  "description": "BROSTCO — Autonomous Procurement Execution Platform",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n web,worker -c cyan,magenta \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:web": "next dev -p 3000",
    "dev:worker": "tsx watch worker/index.ts",
    "build": "next build",
    "start": "concurrently -n web,worker -c cyan,magenta \"npm:start:web\" \"npm:start:worker\"",
    "start:web": "next start -p ${PORT:-3000}",
    "start:worker": "tsx worker/index.ts",
    "worker": "tsx worker/index.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "agent": "tsx scripts/run-agent.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@supabase/supabase-js": "^2.45.4",
    "date-fns": "^4.1.0",
    "docx": "^9.0.2",
    "googleapis": "^144.0.0",
    "next": "14.2.15",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^4.0.1",
    "twilio": "^5.3.5",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "bullmq": "^5.28.1",
    "ioredis": "^5.4.1",
    "playwright": "^1.48.2"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
