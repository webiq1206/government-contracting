run = "npm run start"
entrypoint = "app/page.tsx"
modules = ["nodejs-20", "web", "nix", "python-base-3.13", "postgresql-16"]
hidden = [".next", "node_modules"]

[nix]
channel = "stable-25_05"

[env]
NODE_ENV = "production"
NEXT_TELEMETRY_DISABLED = "1"

[deployment]
run = ["sh", "-c", "npm run start"]
# 4GB heap: the builder's Node caps itself near 2GB by default, and type-
# checking this codebase needs more; without this the build aborts at
# "Checking validity of types" with a heap OOM. If a smaller builder cannot
# honour 4GB, set DEPLOY_SKIP_TYPECHECK=1 here instead - CI has already
# type-checked every commit twice (tsc and a full next build).
build = ["sh", "-c", "NODE_OPTIONS=--max-old-space-size=4096 npm run build"]
deploymentTarget = "vm"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 3100
externalPort = 3001

[workflows]
runButton = "Dev"

[[workflows.workflow]]
name = "Dev"
mode = "sequential"
author = 0

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install && npm run db:setup && npm run dev"

[agent]
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[userenv]

[userenv.shared]
PLATFORM_ADMIN_EMAILS = "brostcoholdings@gmail.com,info@brostco.com,hello@brostco.com"

[userenv.development]
USE_REPLIT_DEV_DB = "true"
