run = "npm run start"
entrypoint = "app/page.tsx"
modules = ["nodejs-22", "web", "nix", "python-base-3.13", "postgresql-16"]
hidden = [".next", "node_modules"]

[nix]
channel = "stable-25_05"

[env]
NODE_ENV = "production"
NEXT_TELEMETRY_DISABLED = "1"

[deployment]
run = ["sh", "-c", "npm run start"]
# Heap size and the post-build IndexNow submit live in build.sh. If a smaller
# builder cannot honour 4GB, set DEPLOY_SKIP_TYPECHECK=1 in the deployment
# environment instead. CI has already type-checked every commit twice.
build = ["bash", "build.sh"]
deploymentTarget = "vm"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 3100
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 5000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Dev"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev -- --strictPort --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Dev"

[agent]
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[userenv]

[userenv.shared]
PLATFORM_ADMIN_EMAILS = "brostcoholdings@gmail.com,info@brostco.com,hello@brostco.com"

[userenv.development]
USE_REPLIT_DEV_DB = "true"
