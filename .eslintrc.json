{
  "root": true,
  "extends": ["next/core-web-vitals"],
  "ignorePatterns": [".next/", "node_modules/", "public/", "coverage/"],
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "parser": "@typescript-eslint/parser",
      "plugins": ["@typescript-eslint"],
      "rules": {}
    },
    {
      "files": ["app/layout.tsx"],
