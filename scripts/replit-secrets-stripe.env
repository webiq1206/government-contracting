# Paste into Replit → Secrets → Edit as .env
# Replace every REPLACE_ME value, then Save.
# Also add these same keys under Deployments → Secrets if you publish.

# All four price IDs are printed by `npm run stripe:setup` for the mode the
# key selects. The MONTHLY/ANNUAL names are the ones the code reads; the old
# STRIPE_PRICE_STANDARD / STRIPE_PRICE_FOUNDING names only cover monthly and
# leave annual checkout silently disabled.
STRIPE_SECRET_KEY=REPLACE_ME_sk_test_or_sk_live
STRIPE_WEBHOOK_SECRET=REPLACE_ME_whsec
STRIPE_PRICE_STANDARD_MONTHLY=REPLACE_ME_price_2997_monthly
STRIPE_PRICE_STANDARD_ANNUAL=REPLACE_ME_price_20979_annual
STRIPE_PRICE_FOUNDING_MONTHLY=REPLACE_ME_price_497_monthly
STRIPE_PRICE_FOUNDING_ANNUAL=REPLACE_ME_price_3479_annual

# Optional: pin when the founding $497 window ends (ISO UTC).
# FOUNDING_PROMO_ENDS_AT=2026-08-16T00:00:00.000Z
