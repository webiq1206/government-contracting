+  .bco-actions { flex-direction: column; }
+  .bco-preview-footer { align-items: start; flex-direction: column; gap: 4px; }
+}
+
+.bco-product-video { min-width: 0; }
+.bco-product-video video { display: block; width: 100%; }
+.bco-video-error { padding: 16px; color: #111a1f; background: #fbf4e6; border: 1px solid #c89c43; border-radius: 8px; font-size: 14px; line-height: 1.5; }
+.bco-video-error .bco-actions { margin-top: 12px; }
