+  --review: 229 188 120;
+  --risk: 241 155 146;
+  --pursue: 133 201 163;
+  color: rgb(var(--foreground));
+}
+.app-navigation [aria-current="page"] { background: #0E6F75; color: #fff; }
+.app-navigation :focus-visible { outline-color: #8FD3D4; }
+.input:focus-visible { box-shadow: 0 0 0 3px rgb(var(--accent) / .15); }
+@media (prefers-reduced-motion: reduce) {
+  html:focus-within { scroll-behavior: auto; }
